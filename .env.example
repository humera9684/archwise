# ---- Which LLM ArchWise uses -------------------------------------------------
# auto | ollama | huggingface | openai | gemini | anthropic | template
# auto = Ollama if running, else the first API key set below, else the built-in template.
LLM_PROVIDER=auto

# ---- Option A: local Qwen via Ollama (free, no key) ---------------------------
# See README "Which Qwen model for your machine?"  e.g. qwen3.5:4b | qwen3.5:9b | qwen3.6:27b
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_THINK=false

# ---- Option B: hosted models with your own API key (billed by the provider) ---
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-8B

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Database (optional) -------------------------------------------------------
# Enables sourced AWS prices (run `python -m pricing_etl refresh`) and saves every
# evaluation for traceability. Without it, ArchWise uses the approximate catalog.
# DATABASE_URL=postgresql://archwise:archwise@localhost:5432/archwise
# ARCHWISE_PRICES_STALE_DAYS=7
# ARCHWISE_REFRESH_HOURS=24

# ---- API (optional) ---------------------------------------------------------------
# Origins allowed to call the API from a browser (the React dev server by default).
# ARCHWISE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- RAG (optional) ---------------------------------------------------------------
# Embedding model for hybrid retrieval (needs: ollama pull nomic-embed-text). BM25 is used otherwise.
# OLLAMA_EMBED_MODEL=nomic-embed-text
# ARCHWISE_RAG_EMBEDDINGS=off
